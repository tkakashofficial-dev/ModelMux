<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ModelMux.Cost</RootNamespace>
    <AssemblyName>ModelMux.Cost</AssemblyName>
  </PropertyGroup>

  <PropertyGroup Label="Package">
    <PackageId>ModelMux.Cost</PackageId>
    <Description>Cost, token and latency tracking for ModelMux. Records what every LLM call cost, attributed per tenant and per feature, with verified pricing for Anthropic, OpenAI and Google Gemini models.</Description>
    <PackageTags>ai;llm;cost;tokens;observability;openai;gemini;anthropic;multitenant</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ModelMux.Core\ModelMux.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ChatClientBuilder and the middleware pipeline live here, not in Abstractions. -->
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.9.0" />
  </ItemGroup>

</Project>
