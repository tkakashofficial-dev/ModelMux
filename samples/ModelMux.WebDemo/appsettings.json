{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ModelMux": {
    "DefaultProfile": "fast",

    "Profiles": {
      "fast": {
        "Provider": "Gemini",
        "Model": "gemini-2.5-flash",
        "ApiKeyEnvironmentVariable": "GEMINI_API_KEY",
        "Description": "Cheap and quick. Everyday chat."
      },

      "smart": {
        "Provider": "OpenAI",
        "Model": "gpt-5-mini",
        "ApiKeyEnvironmentVariable": "OPENAI_API_KEY",
        "Description": "Used for report intent extraction, where accuracy matters."
      },

      "grok": {
        "Provider": "Grok",
        "Model": "grok-4.6",
        "ApiKeyEnvironmentVariable": "XAI_API_KEY",
        "Description": "xAI Grok."
      },

      "private": {
        "Provider": "Ollama",
        "Model": "llama3",
        "Description": "Runs locally. No data leaves the machine and no API key is needed.",
        "Capabilities": {
          "Streaming": true,
          "ToolCalling": false,
          "StructuredOutput": false,
          "Vision": false,
          "ContextWindow": 8192
        }
      },

      "selfhosted": {
        "Provider": "OpenAI",
        "Model": "llama-3-70b",
        "Endpoint": "http://localhost:8000/v1/",
        "ApiKeyEnvironmentVariable": "VLLM_API_KEY",
        "Description": "Your own GPU box running vLLM. Only the Endpoint differs."
      }
    }
  }
}
