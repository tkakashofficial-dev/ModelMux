{
  "ModelMux": {
    "DefaultProfile": "fast",

    "Profiles": {
      "fast": {
        "Provider": "Gemini",
        "Model": "gemini-2.5-flash",
        "ApiKeyEnvironmentVariable": "GEMINI_API_KEY",
        "Description": "Cheap and quick. Everyday summarisation."
      },

      "smart": {
        "Provider": "OpenAI",
        "Model": "gpt-5-mini",
        "ApiKeyEnvironmentVariable": "OPENAI_API_KEY",
        "Description": "Higher quality for harder reasoning."
      },

      "private": {
        "Provider": "Ollama",
        "Model": "llama3",
        "Description": "Runs locally. No data leaves the machine, no API key needed."
      },

      "selfhosted": {
        "Provider": "OpenAI",
        "Model": "llama-3-70b",
        "Endpoint": "http://localhost:8000/v1/",
        "ApiKeyEnvironmentVariable": "VLLM_API_KEY",
        "Description": "Your own GPU box running vLLM. Only the Endpoint differs."
      }
    }
  }
}
